# 두뇌(LLM) 선택: none(규칙만) · anthropic · openai · ollama
LLM_PROVIDER=none
# 모델 이름 (비우면 기본값: anthropic=claude-haiku-5-5, openai=gpt-4o-mini, ollama=qwen2.5:3b)
LLM_MODEL=
# API 키 (사용하는 것만) — 실제 키는 이 파일이 아니라 .env 에만 입력, 저장소·제출물에 올리지 않음
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 로컬 Ollama 주소
OLLAMA_URL=http://localhost:11434/v1
